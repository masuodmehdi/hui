[settings]
functionname=hi_kphy_cmdtype_read_extern_status;  
attributenum=2;
attributeflag = 1 ;   //0:close 1:open

[parameter]
attribute=alias<portnum>          type<uint>      range<0x0,0xFFFFFFFF> 	default<1>;
attribute=alias<status>          type<uint>     range<0x0,0xFFFFFFFF>        default<0>;
[help]
typedef struct __hi_kernel_phy_status_s
{
    hi_uint32 ui_phyid;
    hi_uint32 ui_status; //0:down 1:up
} hi_kernel_phy_status_s;
