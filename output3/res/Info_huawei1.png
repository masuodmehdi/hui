[settings]
functionname=hi_kernel_igmp_add_ifname;  
attributenum=4;
attributeflag = 1 ;   //0:close 1:open

[parameter]
attribute=alias<enable>   		type<uchar>  range<0x0,0x0>      default<0x0>;
attribute=alias<type>   		type<uchar>  range<0x1,0x3>      default<0x1>;
attribute=alias<resv2>   		type<ushort>  range<0x0,0x0>      default<0x0>;
attribute=alias<ifname>         type<string>  range<0x0,16>      default<eth0>;

[help]
增加接口
usage:
hi_cli /home/cli/kigmp/getifname -v ifname ath1	type 1 /*添加ifname：ath1 类型：物理端口*/
parameter list:
type		/* 设备接口类型 （Input）*/
	range <1,3>
	typedef enum
	{
		HI_KERNEL_IGMP_IFTYPE_PHYETH   = 1,
		HI_KERNEL_IGMP_IFTYPE_PHYETH_VIRT,
		HI_KERNEL_IGMP_IFTYPE_WIFI,
	}hi_kernel_igmp_iftype_e;
	
ifname		/* 增加的接口 (Input) */
	range strlen(ifname) <0,15>

	
/* 设备接口信息 */
typedef struct{
    hi_uchar8                uc_enable;
    hi_uchar8                uc_type;      /* 设备类型:物理以太接口/虚拟以太接口/虚拟WIFI接口  */
    hi_uchar8                uc_resv[2];
    
    hi_uchar8                uc_name[HI_KERNEL_IGMP_DEVNAME_LEN];
}hi_kernel_igmp_ifinfo_s;