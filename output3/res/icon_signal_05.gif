[settings]
functionname=hi_kernel_vif_cmdtype_car_delete;  
attributenum=5;
attributeflag = 1 ;   //0:close 1:open

[parameter]
attribute=alias<indx>         type<uint>     range<0x0,0xFFFFFFFF> 	default<1>;
attribute=alias<cir>          type<uint>     range<0x0,0xFFFFFFFF>  default<0>;
attribute=alias<pir>          type<uint>     range<0x0,0xFFFFFFFF>  default<0>;
attribute=alias<bind>         type<ushort>   range<0x0,0xFFFF>      default<0>;
attribute=alias<resv>         type<ushort>   range<0x0,0xFFFF>      default<0>;

[help]
typedef struct
{
    hi_uint32 ui_indx;
    hi_kernel_network_car_s st_data;
}hi_kernel_vif_cmdtype_car_s;

typedef struct
{
    hi_uint32   ui_cir;    /*≥–≈µÀŸ¬ */
    hi_uint32   ui_pir;    /*∑Â÷µÀŸ¬ */          
    hi_ushort16 us_bind;   /*“˝”√º∆ ˝*/
    hi_ushort16 us_resv;
}hi_kernel_network_car_s;c:format>image/gif</dc:format>
